<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>JobOrchestrator</RootNamespace>
    <AssemblyName>JobOrchestrator</AssemblyName>
    <Description>Инфраструктурный SDK оркестрации стадий с зависимостями: расписание, retry/debounce/watchdog, ручные триггеры, потоковая параметризация инстансов через keyspace и каскадное наследование ключей.</Description>
    <!-- CA1848: рекомендация LoggerMessage.Define — не критично для нечастых логов. CA1873: лень аргументов лога — то же. -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="JobOrchestrator.Tests" />
    <InternalsVisibleTo Include="JobOrchestrator.IntegrationTests" />
  </ItemGroup>
</Project>
